@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Компонентная диаграмма — Подключение устройств партнёров (C4)

Container(device_control, "Управление устройствами", "Go", "Команды, активация устройств, события")
System_Ext(devices, "Устройства партнёров", "Оборудование по стандартным протоколам")

System_Boundary(gateway_boundary, "Подключение устройств партнёров") {
    Component(gateway_api, "Gateway API", "Go", "Общий вход сервиса: команды, активация, события; маршрутизация в обе стороны")
    Component(protocol_adapter, "Адаптеры протоколов", "Go", "MQTT, Zigbee и др.: связь с устройствами, установление и закрытие каналов, преобразование форматов к внутреннему")
}

' Единственный вызывающий — сервис управления устройствами
Rel(device_control, gateway_api, "Команды устройствам, активация и отключение устройств", "HTTP")

' Маршрутизация от API к адаптерам: и команды, и жизненный цикл каналов
Rel(gateway_api, protocol_adapter, "Маршрутизирует команды, активацию и отключение устройств", "Внутренний вызов")

' Связь с устройствами и события обратно
Rel(protocol_adapter, devices, "Подключение и обмен по протоколам", "MQTT, Zigbee")
Rel(protocol_adapter, gateway_api, "События устройств и потери связи во внутреннем формате", "Внутренний вызов")

' События наружу — через общий фасад
Rel(gateway_api, device_control, "События устройств и потери связи", "HTTP")
@enduml
