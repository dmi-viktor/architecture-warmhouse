@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Компонентная диаграмма - Комплекты устройств (C4)

Container(self_service, "Клиентский интерфейс умного дома", "ASP NET", "Мастер подключения устройств")
Container(device_control, "Управление устройствами", "Go", "Реестр устройств, активация в шлюзе")

System_Boundary(kits_boundary, "Комплекты устройств") {
    Component(kits_api, "Kits API", "Go", "Общий вход сервиса: каталог, состав, инструкции; публикация комплектов")
    Component(kit_catalog, "Каталог комплектов", "Go", "Состав комплектов, привязанные устройства партнёров, инструкции по добавлению")
}

ContainerDb(kits_db, "Kits DB", "PostgreSQL", "Комплекты, их состав, инструкции")

' Интерфейс запрашивает каталог и инструкции для мастера подключения
Rel(self_service, kits_api, "Запрашивает состав комплекта и инструкции", "HTTP")

' Маршрутизация от API к каталогу
Rel(kits_api, kit_catalog, "Маршрутизирует запросы состава и инструкций", "Внутренний вызов")

' Инструкции по добавлению уходят в сервис управления — там реестр и активация
Rel(kits_api, device_control, "Передаёт инструкции по добавлению устройств комплекта", "HTTP")

' Хранение
Rel(kit_catalog, kits_db, "Читает состав, инструкции, список устройств комплекта", "TCP, SQL")
@enduml